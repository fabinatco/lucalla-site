<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="referrer" content="no-referrer"><title>Lucalla | Bounded English test</title><style>body{margin:0;background:#f7f8fc;color:#17223c;font:16px/1.6 system-ui}main{max-width:680px;margin:40px auto;padding:28px;background:white;border:1px solid #dce2ef;border-radius:20px}h1{font-size:28px;line-height:1.2}button{padding:14px 20px;border:0;border-radius:12px;background:#263c91;color:white;font:inherit;margin:8px 8px 8px 0}button:disabled{opacity:.45}#log{white-space:pre-wrap;overflow-wrap:anywhere;background:#f3f5fb;padding:15px;border-radius:12px}.muted{color:#53617b}@media(max-width:730px){main{margin:12px;padding:20px}}</style><main><p class="muted">Lucalla / English core verification</p><h1>One fictional voice test</h1><p>This page does not activate your business receptionist. Only the approved one-use account can start the test.</p><ul><li>Synthetic English questions, no microphone or real customer facts.</li><li>Deepgram audio and OpenAI text processing. OpenAI may retain logs for up to 30 days.</li><li>One connection, at most 105 seconds. Existing-credit ceiling $0.50. No recharge or retry.</li><li>No booking, phone call, recording storage or message delivery.</li></ul><button id="start">Start approved test</button><button id="stop" disabled>Stop now</button><p id="status" role="status">Not started. Server approval is required.</p><p class="muted">Test questions cover a fictional $85 tire repair, weekday hours, unavailable calendar, instruction refusal and unknown address.</p><pre id="log" aria-live="polite"></pre><a href="./workspace.en.html#overview">Back to workspace</a></main><script type="module">
import {createFictionalAccountTest} from 'https://account.lucalla.com/receptionist/session/assets/account-test-client.js';
const clips=["", "", "", ""];const state={started:false,ended:false,startedAt:null,endedAt:null,turns:[],states:[],questionsPlayed:0};window.testResult=state;let session,ctx,dest,activeSource,nextTimer,hardTimer,question=0;
const el=id=>document.getElementById(id);const log=text=>{el('log').textContent+=text+'\n'};
async function stop(){if(state.ended)return;state.ended=true;state.endedAt=Date.now();clearTimeout(nextTimer);clearTimeout(hardTimer);try{activeSource?.stop()}catch{}await session?.close();await ctx?.close();el('stop').disabled=true;el('status').textContent='Test ended. No automatic retry.';}
async function ask(){if(state.ended||question>=clips.length)return;const i=question++;try{const data=Uint8Array.from(atob(clips[i]),c=>c.charCodeAt(0));const buffer=await ctx.decodeAudioData(data.buffer);if(state.ended)return;activeSource=ctx.createBufferSource();activeSource.buffer=buffer;activeSource.connect(dest);activeSource.start();state.questionsPlayed++;log('Synthetic question '+(i+1)+' played.');}catch{log('Synthetic audio unavailable.');await stop()}}
el('stop').onclick=()=>stop();
el('start').onclick=async()=>{if(state.started)return;state.started=true;state.startedAt=Date.now();el('start').disabled=true;el('stop').disabled=false;el('status').textContent='Preparing one-use test...';try{const token=localStorage.getItem('lc_s');if(!token)throw Error('Sign in to your Lucalla account first.');ctx=new AudioContext({sampleRate:16000});await ctx.resume();dest=ctx.createMediaStreamDestination();const silent=ctx.createGain();silent.gain.value=0;silent.connect(dest);session=createFictionalAccountTest({enabled:true,authToken:token,captureModule:'https://account.lucalla.com/receptionist/session/assets/account-capture-worklet.js',mediaDevices:{getUserMedia:async()=>dest.stream},maxDurationMs:105000,onTranscript:(role,text)=>{state.turns.push({role,text,at:Date.now()});log(role+': '+text)},onState:s=>{state.states.push({state:s,at:Date.now()});el('status').textContent=s;if(s==='closed'){void stop();return}if(s==='turn_complete'){clearTimeout(nextTimer);if(question<clips.length)nextTimer=setTimeout(()=>void ask(),1200);else nextTimer=setTimeout(()=>void stop(),2000)}}});await session.start();if(!state.ended){hardTimer=setTimeout(()=>void stop(),105000);if(!nextTimer)nextTimer=setTimeout(()=>void ask(),4500)}}catch(e){log(e.message);await stop()}};
addEventListener('pagehide',()=>void stop());
</script></html>
